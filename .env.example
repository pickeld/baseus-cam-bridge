# Copy this file to ".env" and fill in your Baseus app login.
# The .env file is git-ignored so your credentials are never committed.

# Your Baseus Security app account (email or phone) and password.
BASEUS_ACCOUNT=you@example.com
BASEUS_PASSWORD=your-baseus-password

# Region: AUTO tries US, EU, AU automatically. Set US/EU/AU to force one.
BASEUS_REGION=AUTO

# Telephone country code used during login/host resolution (e.g. 1=US, 44=UK, 61=AU).
BASEUS_COUNTRYCODE=1

# --- optional tuning ---
# Serve cameras that are currently offline too (their stream just errors until online).
BASEUS_INCLUDE_OFFLINE=1
# Ports for RTSP / HLS / WebRTC.
BASEUS_RTSP_PORT=8554
BASEUS_HLS_PORT=8888
BASEUS_WEBRTC_PORT=8889
